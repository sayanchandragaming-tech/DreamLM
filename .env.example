# Copy this setting to .env.local and replace the placeholder URL with your DreamLM API base URL.
# Do not include the /chat path; the frontend appends it to this value.
VITE_DREAMLM_API_URL=https://your-dreamlm-api.example
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
